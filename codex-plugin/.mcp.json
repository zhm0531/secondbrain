{
  "mcpServers": {
    "secondbrain": {
      "command": "python",
      "args": [
        "./mcp/secondbrain_mcp_server.py"
      ],
      "env": {
        "SECONDBRAIN_URL": "http://127.0.0.1:8765",
        "SECONDBRAIN_ROOT": "memory",
        "SECONDBRAIN_AUTOSTART": "true"
      }
    }
  }
}
